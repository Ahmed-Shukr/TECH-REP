# Public site URL used for sitemap, Open Graph and canonical links.
# Leave unset on Vercel: the project automatically uses your *.vercel.app
# production URL. Set this after you buy a custom domain.
#
# Examples:
# NEXT_PUBLIC_SITE_URL=https://ahmed-portfolio.vercel.app
# NEXT_PUBLIC_SITE_URL=https://ahmedmuhumed.dev
NEXT_PUBLIC_SITE_URL=
